#!/usr/bin/env bash

# Exit immediately on errors, undefined variables, or failed pipeline commands.
set -euo pipefail

# Require exactly two arguments:
#   $1: Release type — major, minor, or patch
#   $2: Release message
if [[ $# -ne 2 ]]; then
  echo "Usage: $0 <major|minor|patch> \"<release message>\"" >&2
  exit 1
fi

RELEASE_TYPE="$1"
MESSAGE="$2"

# Validate the release type.
case "$RELEASE_TYPE" in
  major|minor|patch)
    ;;
  *)
    echo "Error: release type must be major, minor, or patch." >&2
    exit 1
    ;;
esac

# Ensure the release message is not empty.
if [[ -z "${MESSAGE//[[:space:]]/}" ]]; then
  echo "Error: release message cannot be empty." >&2
  exit 1
fi

# Switch to the main branch and update it without creating a merge commit.
git switch main
git pull --ff-only

# Test before anything is changed, so a failing build is never tagged.
python3 -m unittest discover -s tests

# Raise the version everywhere it is written: peye/__init__.py,
# pyproject.toml, the README's PyPI badge and every "peye X.Y.Z" in the
# documentation (see tools/version.py). It refuses when they already disagree.
NEW_VERSION="$(python3 tools/version.py bump "$RELEASE_TYPE")"
VERSION="v$NEW_VERSION"

# Commit the version changes and create an annotated Git tag.
git add -A
git commit -m "$MESSAGE"
git tag -a "$VERSION" -m "$MESSAGE"

# Push the main branch and the new release tag. GitHub sometimes refuses a
# tag pushed right after the branch with a bare "(failed)", and accepts the
# same push moments later, so the tag push is retried a few times.
git push origin main
for attempt in 1 2 3 4 5; do
  if git push origin "$VERSION"; then
    break
  fi
  if [[ $attempt -eq 5 ]]; then
    echo "Error: could not push tag $VERSION; push it with: git push origin $VERSION" >&2
    exit 1
  fi
  echo "Pushing tag $VERSION failed; retrying in $((attempt * 5)) seconds." >&2
  sleep $((attempt * 5))
done

echo "Released $VERSION: $MESSAGE"
