#!/usr/bin/env bash

# Exit immediately on errors, undefined variables, or failed pipeline commands.
set -euo pipefail

# Require exactly two arguments:
#   $1: Release type — major, minor, or patch
#   $2: Release message
if [[ $# -ne 2 ]]; then
  echo "Usage: $0 <major|minor|patch> \"<release message>\"" >&2
  exit 1
fi

RELEASE_TYPE="$1"
MESSAGE="$2"

# Validate the release type.
case "$RELEASE_TYPE" in
  major|minor|patch)
    ;;
  *)
    echo "Error: release type must be major, minor, or patch." >&2
    exit 1
    ;;
esac

# Ensure the release message is not empty.
if [[ -z "${MESSAGE//[[:space:]]/}" ]]; then
  echo "Error: release message cannot be empty." >&2
  exit 1
fi

# Switch to the main branch and update it without creating a merge commit.
git switch main
git pull --ff-only

# Test before anything is changed, so a failing build is never tagged.
python3 -m unittest discover -s tests

# Bump the version in pyproject.toml, peye/__init__.py and the README's PyPI
# badge, which must agree.
NEW_VERSION="$(python3 - "$RELEASE_TYPE" <<'PY'
import re, sys
kind = sys.argv[1]
project = open('pyproject.toml', encoding='utf-8').read()
init = open('peye/__init__.py', encoding='utf-8').read()
old = re.search(r'^version = "(\d+)\.(\d+)\.(\d+)"$', project, re.M)
if old is None or f"__version__ = '{'.'.join(old.groups())}'" not in init:
    sys.exit('pyproject.toml and peye/__init__.py disagree on the version')
major, minor, patch = map(int, old.groups())
major, minor, patch = {'major': (major + 1, 0, 0), 'minor': (major, minor + 1, 0),
                       'patch': (major, minor, patch + 1)}[kind]
new = f'{major}.{minor}.{patch}'
open('pyproject.toml', 'w', encoding='utf-8').write(project.replace(old.group(0), f'version = "{new}"'))
open('peye/__init__.py', 'w', encoding='utf-8').write(
    init.replace(f"__version__ = '{'.'.join(old.groups())}'", f"__version__ = '{new}'"))
# The README's PyPI badge names the version itself: a badge that looks it up
# is cached for hours, so it would show an older release after this one.
readme = open('README.md', encoding='utf-8').read()
badge = f"badge/pypi-v{'.'.join(old.groups())}-blue.svg"
if badge not in readme:
    sys.exit('README.md has no PyPI badge for the current version')
open('README.md', 'w', encoding='utf-8').write(readme.replace(badge, f'badge/pypi-v{new}-blue.svg'))
print(new)
PY
)"
VERSION="v$NEW_VERSION"

# Commit the version changes and create an annotated Git tag.
git add -A
git commit -m "$MESSAGE"
git tag -a "$VERSION" -m "$MESSAGE"

# Push the main branch and the new release tag.
git push origin main
git push origin "$VERSION"

echo "Released $VERSION: $MESSAGE"
