#!/usr/bin/env bash
# Run every test of peye, one numbered line per test: unit tests, the
# examples, and the conformance suite in process and through the command
# line. ./test --help shows how to run a part of them. PYTHON chooses the
# interpreter; by default python, when it is Python 3, else python3.
if [[ -z "${PYTHON:-}" ]]; then
  if command -v python >/dev/null && python -c 'import sys; sys.exit(sys.version_info[0] != 3)'; then
    PYTHON=python
  else
    PYTHON=python3
  fi
fi
exec "$PYTHON" "$(dirname "$0")/tests/run_all.py" "$@"
